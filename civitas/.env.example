# Copia a .env (Docker Compose lo lee solo). Nunca se versiona.
# Local: DOMAIN=http://localhost (HTTP plano). Con "localhost" a secas Caddy forzaría HTTPS autofirmado.
# Producción: el dominio real (p. ej. civitas.tu-dominio.mx) y Caddy emite HTTPS solo.
DOMAIN=http://localhost
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
# HTTP_PORT=8080   # si el puerto 80 está ocupado (y DOMAIN=http://localhost:8080)
