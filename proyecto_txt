  const n = Number((await conn.one('SELECT count(*) AS n FROM colonias')).n);
  if (n === 0) {
    throw new Error('MVP-3: no hay zonas cargadas. Corre primero `etl mvp2` (los listados se asignan a las AGEB de MVP-2).');
