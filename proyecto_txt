  await conn.query(SQL_LISTADO, [
    fuente, cargaId,
    lote.map((l) => l.id), lote.map((l) => l.url), lote.map((l) => l.tipo), lote.map((l) => l.precio),
    lote.map((l) => l.superficie), lote.map((l) => l.recamaras), lote.map((l) => l.publicado),
