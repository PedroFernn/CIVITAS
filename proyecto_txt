<script>
(function(){
  var screens = Array.prototype.slice.call(document.querySelectorAll('.screen'));
  var list = document.getElementById('index');

  // ---------- índice lateral (se genera a partir de las secciones) ----------
  screens.forEach(function(s){
    var li = document.createElement('li');
    if (s.id === 'p16') li.className = 'later';
    var b = document.createElement('button');
    b.type = 'button';
    b.setAttribute('data-target', s.id);
    b.innerHTML = '<span class="num">' + s.dataset.num + '</span><span>' + s.dataset.title + '</span>';
    b.setAttribute('aria-current', s.classList.contains('on') ? 'true' : 'false');
    li.appendChild(b);
    list.appendChild(li);
  });

  // ---------- pie de navegación (salidas declaradas + anterior/siguiente) ----------
  // Cada sección declara a dónde lleva en data-flow="pXX|etiqueta, pYY|etiqueta".
  // El pie se genera aquí para que las 16 pantallas tengan el mismo componente.
  var meta = {};
  screens.forEach(function(s){ meta[s.id] = { num: s.dataset.num, title: s.dataset.title }; });

  function jump(id, label, cls){
    if (!meta[id]) return '';
    return '<span class="jump ' + (cls || '') + '" data-target="' + id + '">' +
           '<span class="n">' + meta[id].num + '</span>' +
           (label || meta[id].title) + '</span>';
  }

  screens.forEach(function(s, i){
    var foot = document.createElement('div');
    foot.className = 'screen-foot';
    var html = '';

    var exits = (s.dataset.flow || '').split(',').map(function(x){ return x.trim(); }).filter(Boolean);
    if (exits.length){
      html += '<span class="fh">SALIDAS</span><span class="exits">';
      exits.forEach(function(x){
        var p = x.split('|');
        html += jump(p[0].trim(), (p[1] || '').trim());
      });
      html += '</span>';
    }

    html += '<span class="nav"><span class="fh">← →</span>';
    if (i > 0) html += jump(screens[i - 1].id, 'anterior', 'prev');
    if (i < screens.length - 1) html += jump(screens[i + 1].id, 'siguiente', 'next');
    html += '</span>';

    foot.innerHTML = html;
    s.appendChild(foot);
  });

  // ---------- mecanismo central de cambio de pantalla ----------
  // Quita `.on` de la sección activa, se la asigna a #screenId, sincroniza
  // el estado aria-current del menú lateral y hace scroll suave al inicio.
  function goToScreen(screenId){
    var target = document.getElementById(screenId);
    if (!target || !target.classList.contains('screen')) return;

    screens.forEach(function(s){
      s.classList.toggle('on', s === target);
    });

    Array.prototype.forEach.call(list.querySelectorAll('button'), function(b){
      b.setAttribute('aria-current', b.getAttribute('data-target') === screenId ? 'true' : 'false');
    });

    try { localStorage.setItem('civitas-wf-screen', screenId); } catch (e) {}
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Restaura la última pantalla vista sin animar el scroll (carga inicial).
  function restoreScreen(screenId){
    var target = document.getElementById(screenId);
    if (!target || !target.classList.contains('screen')) return;
    screens.forEach(function(s){ s.classList.toggle('on', s === target); });
    Array.prototype.forEach.call(list.querySelectorAll('button'), function(b){
      b.setAttribute('aria-current', b.getAttribute('data-target') === screenId ? 'true' : 'false');
    });
  }

  // ---------- delegación de clics: menú lateral + interacciones del cuerpo ----------
  // Tanto los botones del índice como cualquier elemento del cuerpo con
  // data-target="pXX" (creado o marcado abajo) disparan la misma función,
  // así el índice nunca se desincroniza de la pantalla mostrada.
  document.addEventListener('click', function(e){
    var el = e.target.closest('[data-target]');
    if (!el) return;
    e.preventDefault();
    goToScreen(el.getAttribute('data-target'));
  });

  document.addEventListener('keydown', function(e){
    if (e.target && /^(INPUT|TEXTAREA)$/.test(e.target.tagName)) return;
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    var i = screens.findIndex(function(s){ return s.classList.contains('on'); });
    if (i < 0) return;
    var next = e.key === 'ArrowRight' ? i + 1 : i - 1;
    if (next >= 0 && next < screens.length) goToScreen(screens[next].id);
  });

  try {
    var saved = localStorage.getItem('civitas-wf-screen');
    if (saved) restoreScreen(saved);
  } catch (e) {}
})();
</script>
