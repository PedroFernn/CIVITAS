  resolverRutasRenta(cfg);
  const parser = obtenerParser(cfg.fuenteRenta);
  const conn = await conectar(cfg.databaseUrl);
  try {
    await migrar(conn);
    await exigirZonas(conn);
    await limpiarOtroModoRenta(conn, cfg.modo);

