  ['relevancia', 'Relevancia (con búsqueda)'], ['nombre', 'Nombre'], ['precio_m2', 'Renta por m² (mayor primero)'], ['renta', 'Renta mediana (mayor primero)'],
  ['comercios', 'Más comercios'], ['paradas', 'Más paradas'], ['listados', 'Más listados'],
