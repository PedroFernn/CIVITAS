        lat: get(row, 'latitud', 'lat'),
        lon: get(row, 'longitud', 'lon', 'lng'),
        publicado: get(row, 'fecha_publicacion', 'publicado', 'fecha'),
      } satisfies ListadoCrudo;
    }
  },
};


