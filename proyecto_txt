    const hit = todos.find((f) => {
      const n = path.basename(f).toLowerCase();
      if (shp && p === 'a.shp') return n.endsWith('a.shp');
      if (shp && p === 'ageb') return n.includes('ageb') && n.endsWith('.shp');
      return p.startsWith('.') ? n.endsWith(p) : n === p;
    });
    if (hit) return hit;
  }
  return undefined;
}


