  const bearer = (t: string) => ({ Authorization: `Bearer ${t}` });
  const registro = { usuario: 'maria', correo: 'maria@ejemplo.mx', contrasena: 'clave-segura-1', proposito: 'rentar', acepta_aviso: true };

