  }
  .check.on{border-color:var(--pen);}
  .check.on::after{content:"";position:absolute;left:2px;top:2px;right:2px;bottom:2px;background:var(--pen);}

  .kv{display:grid;grid-template-columns:auto 1fr;gap:5px 10px;font-size:12px;align-items:center;}
  .kv .k{color:var(--graphite);font-family:"IBM Plex Mono",monospace;font-size:11px;}

  /* ---------- pie de pantalla: salidas y recorrido ---------- */
  .screen-foot{
    border:1px solid var(--rule);border-top:0;background:var(--fill-2);
    padding:9px 12px;display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;
  }
  .screen-foot .fh{
    font-family:"IBM Plex Mono",monospace;font-size:10.5px;letter-spacing:.06em;color:var(--graphite);
  }
  .screen-foot .exits{display:flex;flex-wrap:wrap;gap:6px;}
  .screen-foot .nav{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto;}
  .jump{
    display:inline-flex;align-items:center;gap:7px;border:1px solid var(--rule);background:var(--sheet);
    padding:4px 9px;font-size:11.5px;color:var(--ink);white-space:nowrap;
  }
  .jump .n{font-family:"IBM Plex Mono",monospace;font-size:10.5px;color:var(--pen);}
  .jump.prev::before{content:"\2190";color:var(--graphite);}
  .jump.next::after{content:"\2192";color:var(--graphite);}

  /* ---------- afordancia de los elementos que navegan ---------- */
  [data-target]{cursor:pointer;transition:background-color .12s ease,border-color .12s ease,color .12s ease;}
  .btn[data-target]::after{content:"\203A";font-family:"IBM Plex Mono",monospace;opacity:.5;}
  .btn[data-target]:hover,.jump[data-target]:hover,.chip[data-target]:hover,.route .r[data-target]:hover{
    border-color:var(--pen);color:var(--pen);background:var(--pen-soft);
  }
  .btn[data-target]:hover::after{opacity:1;}
  .lock[data-target]:hover,.card[data-target]:hover,.blk[data-target]:hover{border-color:var(--pen);color:var(--pen);}
  .navlinks span[data-target]:hover,.meta[data-target]:hover,.foot-strip span[data-target]:hover{color:var(--pen);}
  .tbl tr[data-target]:hover td{background:var(--pen-soft);}

  /* ---------- entrada de pantalla ---------- */
  .screen.on{animation:sheet-in .18s ease-out;}
  @keyframes sheet-in{from{opacity:0;transform:translateY(5px);}to{opacity:1;transform:none;}}

  @media (max-width:900px){
    .layout{grid-template-columns:1fr;}
    nav.index{position:static;}
    nav.index ul{display:flex;overflow-x:auto;padding:6px;}
    nav.index button{white-space:nowrap;width:auto;border-left:0;border-bottom:2px solid transparent;}
    nav.index button[aria-current="true"]{border-left:0;border-bottom-color:var(--pen);}
    .body{grid-template-columns:1fr;}
    .canvas{border-right:0;border-bottom:1px solid var(--rule-soft);}
