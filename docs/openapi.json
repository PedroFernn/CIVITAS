{"openapi":"3.0.0","paths":{"/zonas":{"get":{"operationId":"ZonasController_listar","summary":"Lista las zonas publicadas","description":"Solo zonas con estado \"publicada\", ordenadas por ciudad y nombre. Un filtro sin coincidencias devuelve [] (200).","parameters":[{"name":"ciudad","required":false,"in":"query","description":"Igualdad exacta (distingue mayúsculas y acentos).","schema":{"example":"Puebla","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ZonaDto"}}}}}},"tags":["zonas"]}},"/health":{"get":{"operationId":"HealthController_check","summary":"Estado de la API y de la base de datos","description":"Ejecuta SELECT 1; si la base no responde falla con 500.","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthDto"}}}},"500":{"description":"La base de datos no responde."}},"tags":["health"]}}},"info":{"title":"CIVITAS API","description":"API pública de solo lectura del MVP-1. Sin autenticación ni datos personales.","version":"0.1.0","contact":{}},"tags":[],"servers":[{"url":"/api"}],"components":{"schemas":{"ZonaDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"nombre":{"type":"string","example":"Centro Histórico"},"ciudad":{"type":"string","example":"Puebla"},"indiceAsequibilidad":{"type":"number","nullable":true,"description":"renta_mediana / ingreso_mediano. Nulo mientras falte alguno (métricas llegan en sprints 2-5)."},"lng":{"type":"number","nullable":true,"description":"Longitud del centroide (WGS84)."},"lat":{"type":"number","nullable":true,"description":"Latitud del centroide (WGS84)."},"actualizadoEn":{"type":"string","format":"date-time"}},"required":["id","nombre","ciudad","indiceAsequibilidad","lng","lat","actualizadoEn"]},"HealthDto":{"type":"object","properties":{"status":{"type":"string","example":"ok"}},"required":["status"]}}}}